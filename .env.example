# 复旦 UIS 账号。动态口令填写绑定时获取的 Base32 密钥。
StuId=
UISPsw=
UIS_TOTP_SECRET=

# 初始订阅（课程网址末尾的数字，多个用英文逗号分隔）。
# 在网页保存订阅后，以 data/subscriptions.json 为准。
COURSE_IDS=

# 检查录播无需模型密钥。可在网页的「API 设置」添加，也可在下面填写。
# DASHSCOPE_API_KEY 对应项目中的 ModelScope 配置。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# 如要自行指定支持 OpenAI Chat Completions 的供应商，填写下面三项。
# 填好后可在本地网页选用这个 API，服务地址通常以 /v1 结尾。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 可选，设为 true 时优先尝试 iCourse 官方字幕，缺失或不完整时尝试本机语音识别。
# USE_OFFICIAL_TRANSCRIPT=true

# 默认路径由 scripts/setup_local.sh 准备。
# ASR_MODEL_DIR=sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
# SILERO_VAD_PATH=silero_vad.onnx
